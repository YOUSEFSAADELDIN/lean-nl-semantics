import LeanNLSemantics.FraCaS.Section1.Monotonicity.BlindEval
import LeanNLSemantics.FraCaS.Section1.Monotonicity.BlindEvalUnknown

/-!
# Blind evaluation for Sections 1-2's `.unknown`/`.undef` countermodel-pair problems

`BlindEval.lean` itself only covers **bare** `fracas_NNN` theorems - every
`.unknown`/`.undef` problem in Sections 1-2 is instead represented as a
`_dir1`/`_dir2` countermodel pair, which isn't a single entailment-shaped
statement a binary yes/no/unknown procedure has anything to pose a question
about (see `BlindEval.lean`'s own header). `BlindEvalUnknown.lean`
(generated by `scripts/gen_blind_eval_unknown.py`) closes that specific gap:
a bare `Prop`-valued `def` per problem, the *generic* form of what that
problem's own dir1/dir2 pair already demonstrates concretely - never
proved, since a genuine independence claim is not a theorem in either
direction. This file feeds each one's value through the exact same
`attemptClose`/`negateConclusion` pipeline `BlindEval.lean` already uses,
expecting **both** directions to fail: that failure (not a yes/no verdict)
is itself the correct automated outcome here, and failure on both sides is
compared against the gold `.unknown`/`.undef` answer exactly the way
`BlindEval.lean`'s own `answerMatches` already collapses that distinction
(a binary procedure has no way to tell "genuinely undecided" apart from
"the source's answer wasn't a literal yes/no/don't-know").

Deliberately not imported by anything (same reasoning as `BlindEval.lean`/
`Coverage.lean`: nothing downstream needs this, and it's run as its own CI
step) - run directly.
-/
open Lean Lean.Meta Lean.Elab Lean.Elab.Tactic Lean.Elab.Command

namespace FraCaS.Section1.Monotonicity.BlindEval

elab "#blind_eval_unknown" : command => liftTermElabM do
  let env ← getEnv
  let mut matched : Array (Nat × String) := #[]
  let mut mismatches : Array (Nat × String × String) := #[]
  let mut contradictions : Array Nat := #[]
  let mut missingClaim : Array Nat := #[]

  for (idn, goldStr, claimName) in blindEvalUnknownRegistry do
    let some cinfo := env.find? claimName
      | do
        missingClaim := missingClaim.push idn
        continue
    let some ty := cinfo.value?
      | do
        missingClaim := missingClaim.push idn
        continue

    logInfo m!"blind_eval_unknown: attempting fracas_{idn}"
    let posOk ← attemptClose ty
    let tyNeg ← negateConclusion ty
    let negOk ← attemptClose tyNeg

    let decision :=
      if posOk && !negOk then "yes"
      else if negOk && !posOk then "no"
      else if !posOk && !negOk then "unknown"
      else "contradiction"

    if decision == "contradiction" then
      contradictions := contradictions.push idn
      continue

    -- Every registry entry's own gold answer is `.unknown`/`.undef` by
    -- construction (that's the whole point of this scan) - both compared
    -- against automated `"unknown"` exactly as `BlindEval.lean`'s own
    -- `answerMatches` already does for the bare-theorem scan.
    if decision == "unknown" then
      matched := matched.push (idn, decision)
    else
      mismatches := mismatches.push (idn, goldStr, decision)

  let total := matched.size + mismatches.size + contradictions.size + missingClaim.size
  logInfo m!"blind_eval_unknown: {matched.size}/{total} automated verdicts correctly say \
    unknown ({contradictions.size} contradictions, {missingClaim.size} missing claim constants)"
  logInfo m!"matched [{matched.size}]: {matched.toList}"
  logInfo m!"mismatches [{mismatches.size}] - automated chain actually closed one direction, \
    contradicting the gold .unknown/.undef verdict: {mismatches.toList}"
  logInfo m!"contradictions (both directions closed - flag, do not silently resolve) \
    [{contradictions.size}]: {contradictions.toList}"
  logInfo m!"missing claim constants [{missingClaim.size}]: {missingClaim.toList}"

end FraCaS.Section1.Monotonicity.BlindEval

#blind_eval_unknown
