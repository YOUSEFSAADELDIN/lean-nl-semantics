import LeanNLSemantics.FraCaS.Section1.Monotonicity.BlindEvalCore
import LeanNLSemantics.FraCaS.BlindEvalUnknown3to9

/-!
# Blind evaluation for Sections 3-9's `.unknown`/`.undef` countermodel-pair problems

The Sections 3-9 analogue of `Section1/Monotonicity/BlindEvalUnknownScan
.lean` - see that file's own header for the full methodology (a bare,
deliberately unprovable, generic `Prop` per countermodel-pair problem,
fed through the exact same `attemptClose`/`negateConclusion` pipeline
`BlindEvalCore.lean` provides, expecting **both** directions to fail).

Unlike that file, none of this file's own 60 claims (`BlindEvalUnknown3to9
.lean`, generated by `scripts/gen_blind_eval_unknown_3to9.py`) have an
already-negated final conclusion (no bare `fracas_NNN_claim` here ends in
`¬X`/`x ≠ y` the way some of `BlindEvalSections3to9.lean`'s *bare theorems*
do) - every one of these schematic claims was authored directly for this
scan, with the tested position always put last and always stated
positively, so plain `negateConclusion` (wrap the whole thing in `Not`,
never strip one already there) is correct here without needing
`BlindEvalSections3to9.lean`'s own `flipConclusion`/`isNeg` machinery.

Deliberately not imported by anything (same reasoning as every other
blind-eval scan file) - run directly.
-/
open Lean Lean.Meta Lean.Elab Lean.Elab.Tactic Lean.Elab.Command
open FraCaS.Section1.Monotonicity.BlindEval (attemptClose negateConclusion)

namespace FraCaS.BlindEvalUnknown3to9Scan

elab "#blind_eval_unknown_3to9" : command => liftTermElabM do
  let env ← getEnv
  let mut matched : Array (Nat × String) := #[]
  let mut mismatches : Array (Nat × String × String) := #[]
  let mut contradictions : Array Nat := #[]
  let mut missingClaim : Array Nat := #[]

  for (idn, goldStr, claimName) in FraCaS.blindEvalUnknownRegistry3to9 do
    let some cinfo := env.find? claimName
      | do
        missingClaim := missingClaim.push idn
        continue
    let some ty := cinfo.value?
      | do
        missingClaim := missingClaim.push idn
        continue

    logInfo m!"blind_eval_unknown_3to9: attempting fracas_{idn}"
    let posOk ← attemptClose ty
    let tyNeg ← negateConclusion ty
    let negOk ← attemptClose tyNeg

    let decision :=
      if posOk && !negOk then "yes"
      else if negOk && !posOk then "no"
      else if !posOk && !negOk then "unknown"
      else "contradiction"

    if decision == "contradiction" then
      contradictions := contradictions.push idn
      continue

    if decision == "unknown" then
      matched := matched.push (idn, decision)
    else
      mismatches := mismatches.push (idn, goldStr, decision)

  let total := matched.size + mismatches.size + contradictions.size + missingClaim.size
  logInfo m!"blind_eval_unknown_3to9: {matched.size}/{total} automated verdicts correctly say \
    unknown ({contradictions.size} contradictions, {missingClaim.size} missing claim constants)"
  logInfo m!"matched [{matched.size}]: {matched.toList}"
  logInfo m!"mismatches [{mismatches.size}] - automated chain actually closed one direction, \
    contradicting the gold .unknown/.undef verdict: {mismatches.toList}"
  logInfo m!"contradictions (both directions closed - flag, do not silently resolve) \
    [{contradictions.size}]: {contradictions.toList}"
  logInfo m!"missing claim constants [{missingClaim.size}]: {missingClaim.toList}"

end FraCaS.BlindEvalUnknown3to9Scan

#blind_eval_unknown_3to9
